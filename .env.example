# Authentication: production currently uses local SQLite on the customer host.
MCP_AUTH_BACKEND=sqlite
MCP_LOCAL_AUTH_DB_PATH=C:\ProgramData\RockyMCP\auth\oauth.sqlite3
MCP_REQUIRE_AUTH=true

# Runtime
MCP_HOST=127.0.0.1
MCP_PORT=8085
MCP_KEEPALIVE_SEC=120
MCP_LOG_DIR=C:\ProgramData\RockyMCP\logs
MCP_LOG_LEVEL=INFO

# Read-only source connections. Set real values only in the customer-host env file.
POS_PG_DSN=
WMS_PG_DSN=
DASHBOARD_PG_DSN=
WMS_QUERY_TIMEOUT_MS=15000

# Rocky Lens Dashboard API.
ROCKY_DASHBOARD_API_BASE_URL=https://api.rocky.endpoint.eggstech.io
ROCKY_DASHBOARD_IDENTITY_BASE_URL=https://identity.rocky.endpoint.eggstech.io
ROCKY_DASHBOARD_API_TOKEN=
ROCKY_DASHBOARD_USERNAME=
ROCKY_DASHBOARD_PASSWORD=

# Optional AI provider.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=deepseek-r1:8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

