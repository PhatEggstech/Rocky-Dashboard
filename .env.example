# Copy to .env and replace every placeholder locally. Never commit .env.
WAREHOUSE_POSTGRES_USER=hmk
WAREHOUSE_POSTGRES_PASSWORD=replace-me
WAREHOUSE_POSTGRES_DB=hmk_warehouse
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me

# Runtime services may also use these direct DSNs.
DASHBOARD_PG_DSN=postgresql://user:password@localhost:5432/rocky_dashboard
POS_PG_DSN=postgresql://readonly_user:password@localhost:5432/rocky
WMS_PG_DSN=postgresql://readonly_user:password@localhost:5432/rocky_wms

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=deepseek-r1:8b
OPENROUTER_API_KEY=
