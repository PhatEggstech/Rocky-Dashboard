<service>
  <id>RockyMCPStaging</id>
  <name>Rocky MCP Server (Staging)</name>
  <description>Rocky Lens MCP staging server on loopback port 8086</description>
  <executable>C:\ProgramData\RockyMCP\staging\venv\Scripts\python.exe</executable>
  <arguments>C:\ProgramData\RockyMCP\staging\scripts\start_mcp_production_oauth.py</arguments>
  <workingdirectory>C:\ProgramData\RockyMCP\staging</workingdirectory>
  <env name="MCP_ENV_FILE" value="C:\ProgramData\RockyMCP\config\.env.staging" />
  <env name="MCP_LOG_DIR" value="C:\ProgramData\RockyMCP\logs\staging" />
  <env name="MCP_PORT" value="8086" />
  <startmode>Manual</startmode>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>C:\ProgramData\RockyMCP\logs\staging</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
