<service>
  <id>RockyMCPPortalCanary</id>
  <name>RockyMCPPortalCanary</name>
  <description>Rocky Lens MCP Streamable HTTP server</description>
  <executable>C:\ProgramData\RockyMCP\releases\20261015-portal-getonly\venv\Scripts\python.exe</executable>
  <arguments>C:\ProgramData\RockyMCP\releases\20261015-portal-getonly\scripts\start_mcp_production_oauth.py</arguments>
  <workingdirectory>C:\ProgramData\RockyMCP\releases\20261015-portal-getonly</workingdirectory>
  <env name="MCP_ENV_FILE" value="C:\ProgramData\RockyMCP\backups\20261015-portal-getonly\canary.env" />
  <env name="MCP_LOG_DIR" value="C:\ProgramData\RockyMCP\logs\portal-canary" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>C:\ProgramData\RockyMCP\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <env name="MCP_PORTAL_SESSIONS_ENABLED" value="true" />
  <env name="MCP_PORTAL_UAT_ENABLED" value="false" />
  <env name="MCP_PORTAL_ALLOW_READ_POST" value="false" />
  <env name="MCP_PORTAL_SESSION_DB_PATH" value="C:\ProgramData\RockyMCP\config\portal-production.sqlite3" />
  <env name="MCP_PORTAL_KEY_FILE" value="C:\ProgramData\RockyMCP\config\portal-production.key" />
  <env name="MCP_PORT" value="8087" />
</service>